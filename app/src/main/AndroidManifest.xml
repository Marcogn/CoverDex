<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed from Phase 1 onward for the dataset sync (the CSV catalogue) and for sprite URLs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Phase 8: in-app updates hand the downloaded APK to the system installer (PackageInstaller).
      The user still enables "install unknown apps" for this app and confirms every install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".CoverDexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoverDex">

        <!--
          In-app language picker (Settings): automatic persistence of the per-app language chosen
          with AppCompatDelegate.setApplicationLocales() — without this service/meta-data
          (autoStoreLocales) the preference would have to be saved by hand.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Phase 8: PackageInstaller session status (explicit PendingIntent from ApkInstaller). -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CoverDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
